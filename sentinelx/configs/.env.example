SENTINELX_MODE=demo
SENTINELX_REMEDIATION_ENABLED=false
SENTINELX_DB_PATH=.local/sentinelx.db
SENTINELX_SCAN_INTERVAL=300
SENTINELX_MAX_AGE_DAYS=30
SENTINELX_ROTATION_DAYS=30
SENTINELX_INACTIVITY_DAYS=30
SENTINELX_READER_KEY=replace-with-distinct-random-32-character-key
SENTINELX_OPERATOR_KEY=replace-with-distinct-random-32-character-key
SENTINELX_APPROVER_KEY=replace-with-distinct-random-32-character-key
SENTINELX_API_URL=http://127.0.0.1:8000
# Live mode only. Encryption key must be injected from an OS/cloud secret store.
# SENTINELX_CONFIG_FILE=configs/provider.enc
# SENTINELX_CONFIG_KEY=replace-with-fernet-key